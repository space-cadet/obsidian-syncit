{
	"name": "obsidian-syncit",
	"version": "0.1.0",
	"description": "Lightweight WebDAV vault sync for Obsidian",
	"main": "main.js",
	"scripts": {
		"dev": "node esbuild.config.mjs",
		"build": "tsc -noEmit -skipLibCheck && node esbuild.config.mjs production",
		"test": "vitest run",
		"test:watch": "vitest",
		"version": "node version-bump.mjs && git add manifest.json versions.json"
	},
	"keywords": [
		"obsidian",
		"obsidian-plugin",
		"sync",
		"webdav",
		"nextcloud",
		"owncloud"
	],
	"author": "space-cadet",
	"license": "GPL-3.0",
	"repository": {
		"type": "git",
		"url": "https://github.com/space-cadet/obsidian-syncit.git"
	},
	"devDependencies": {
		"@types/node": "^20.0.0",
		"esbuild": "^0.20.0",
		"obsidian": "latest",
		"tslib": "^2.6.0",
		"typescript": "^5.3.0",
		"vitest": "^1.0.0"
	}
}
